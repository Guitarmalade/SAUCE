generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  FREE
  PAID
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String?
  subscription   SubscriptionTier @default(FREE)
  studentProfile StudentProfile?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model StudentProfile {
  id                 String            @id @default(cuid())
  userId             String            @unique
  currentLevel       Int               @default(1)
  streak             Int               @default(0)
  teacherEnabled     Boolean           @default(false)
  primaryKey         String            @default("A major")
  chosenPath         String            @default("core-first")
  focusAreas         String[]
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals              Goal[]
  practiceSessions   PracticeSession[]
  progressRecords    ProgressRecord[]
}

model Goal {
  id          String         @id @default(cuid())
  profileId   String
  horizon     String
  title       String
  description String?
  profile     StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model PracticeSession {
  id          String         @id @default(cuid())
  profileId   String
  area        String
  level       Int
  durationSec Int
  notes       String?
  startedAt   DateTime
  endedAt     DateTime?
  profile     StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  entries     PracticeEntry[]
}

model PracticeEntry {
  id          String          @id @default(cuid())
  sessionId   String
  exerciseKey String
  bpm         Int?
  confidence  Int?
  notes       String?
  durationMin Int             @default(0)
  submittedAt DateTime        @default(now())
  session     PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ProgressRecord {
  id            String         @id @default(cuid())
  profileId     String
  area          String
  level         Int
  completionPct Int            @default(0)
  confidenceAvg Float          @default(0)
  unlocked      Boolean        @default(false)
  profile       StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}
