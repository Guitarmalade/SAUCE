{
  "name": "sauce",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @sauce/api dev",
    "dev:chrome": "node ./scripts/devtools/launch-chrome-debug.mjs",
    "dev:chrome:app": "node ./scripts/devtools/launch-chrome-debug.mjs --url http://127.0.0.1:3000",
    "dev:web": "pnpm --filter @sauce/web dev",
    "lint": "turbo run lint",
    "prototype:zip": "make prototype-zip",
    "cdp:console": "node ./scripts/devtools/cdp.mjs console",
    "cdp:endpoint": "node ./scripts/devtools/cdp.mjs endpoint",
    "cdp:pages": "node ./scripts/devtools/cdp.mjs pages",
    "cdp:requests": "node ./scripts/devtools/cdp.mjs requests",
    "cdp:screenshot": "node ./scripts/devtools/cdp.mjs screenshot",
    "cdp:trace": "node ./scripts/devtools/cdp.mjs trace",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
